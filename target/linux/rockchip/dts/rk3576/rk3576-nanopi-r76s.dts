/dts-v1/;

#include <rockchip/rk3576-nanopi-r76s.dts>
#include "rk3576-patch.dtsi"
#include "rk3576-ip.dtsi"
#include "rk3576-ip-rk806.dtsi"

#include "rk3576-ramoops.dtsi"

/ {
	eth_order = "0001:21:00.0,0000:01:00.0";
};

&i2c1 {
	pmic@23 {
		/* 0: restart PMU;
		 * 1: reset all the power off reset registers,
		 *    forcing the state to switch to ACTIVE mode;
		 * 2: Reset all the power off reset registers,
		 *    forcing the state to switch to ACTIVE mode,
		 *    and simultaneously pull down the RESETB PIN for 5mS before releasing
		 */
		// pmic-reset-func = <1>;
		rockchip,reset-mode = <1>;
	};
};

/*
&pcie0 {
    rockchip,irq-affinity = <0xf0>;
};

&pcie1 {
    rockchip,irq-affinity = <0xf0>;
};
*/

/*
 * The command queue engine times out on the FORESEE A3A551 eMMC
 * ("cqhci: timeout for tag ..." followed by endless CQE recovery),
 * which stalls all I/O and leaves the board stuck in boot.
 * 24.10 ran the same eMMC in HS400ES without CQE.
 */
&sdhci {
	/delete-property/ supports-cqe;
	/*
	 * HS400 tuning falls back through mmc_hs400_to_hs200(), which drops
	 * the clock below 52MHz while the controller is still in HS400 and
	 * breaks the link ("Can't reduce the clock ...", followed by I/O
	 * errors and SQUASHFS read failures). Stay on HS200, where retuning
	 * happens in place at full speed.
	 */
	/delete-property/ mmc-hs400-1_8v;
	/delete-property/ mmc-hs400-enhanced-strobe;
	mmc-hs200-1_8v;
};

&sdmmc {
	cd-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_LOW>;
};
